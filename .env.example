# ==============================================================================
# Autonomous AI Cyber Defense Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
# Fill in production-grade secrets and connection endpoints.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Autonomous AI Cyber Defense Platform"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"               # Options: development, staging, production
DEBUG=False                             # Set to False in production
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_KEY_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440        # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (JSON array or comma-separated URLs)
CORS_ORIGINS='["http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:5173", "http://127.0.0.1:5173"]'

# ------------------------------------------------------------------------------
# 3. Primary Relational Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Docker Compose default connection:
DATABASE_URL="postgresql+asyncpg://cyberdefense:cyberdefense_secure_pass@postgres:5432/cyberdefense"
# For local development without Docker:
# DATABASE_URL="sqlite+aiosqlite:///./cyberdefense.db"
DB_ECHO=False

# ------------------------------------------------------------------------------
# 4. In-Memory Cache & Message Broker (Redis 7)
# ------------------------------------------------------------------------------
REDIS_URL="redis://:redis_secure_pass@redis:6379/0"
REDIS_ENABLED=True                      # Fallback to in-memory cache if False

# ------------------------------------------------------------------------------
# 5. Graph Knowledge & Attack Path Database (Neo4j 5)
# ------------------------------------------------------------------------------
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="cyberdefense_neo4j_pass"
NEO4J_ENABLED=True                      # Fallback to in-memory graph mock if False

# ------------------------------------------------------------------------------
# 6. High-Throughput Event Streaming (Apache Kafka)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS="kafka:9092"
KAFKA_ENABLED=False                     # Enable when external Kafka cluster is attached

# ------------------------------------------------------------------------------
# 7. Autonomous SOC Safeguards & Operational Controls
# ------------------------------------------------------------------------------
# When SIMULATION_MODE is True, all SOAR actions (e.g. host isolation, IP blocking)
# are logged in audit trail and dry-run verified without modifying real network state.
SIMULATION_MODE=True

# Enforces Human-In-The-Loop approval for High / Critical severity containment playbooks
REQUIRE_HUMAN_APPROVAL_FOR_CONTAINMENT=True

# ------------------------------------------------------------------------------
# 8. Initial Security Administrator Credentials (Auto-Seeded on Startup)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL="admin@cyberdefense.org"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="AdminSecOps2026!"

